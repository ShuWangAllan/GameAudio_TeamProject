############################################################
# Unity project: Samurai-GameAudio
############################################################

# Unity generated folders
/Samurai-GameAudio/[Ll]ibrary/
/Samurai-GameAudio/[Tt]emp/
/Samurai-GameAudio/[Oo]bj/
/Samurai-GameAudio/[Bb]uild/
/Samurai-GameAudio/[Bb]uilds/
/Samurai-GameAudio/[Ll]ogs/
/Samurai-GameAudio/[Uu]ser[Ss]ettings/
/Samurai-GameAudio/[Mm]emoryCaptures/
/Samurai-GameAudio/[Rr]ecordings/

# Optional Unity generated folders
/Samurai-GameAudio/[Bb]ee/
/Samurai-GameAudio/[Bb]ee~/
/Samurai-GameAudio/ExportedObj/
/Samurai-GameAudio/.gradle/
/Samurai-GameAudio/.vs/
/Samurai-GameAudio/.idea/
/Samurai-GameAudio/.vscode/
/Samurai-GameAudio/.consulo/

# Generated solution / project files
/Samurai-GameAudio/*.csproj
/Samurai-GameAudio/*.unityproj
/Samurai-GameAudio/*.sln
/Samurai-GameAudio/*.suo
/Samurai-GameAudio/*.tmp
/Samurai-GameAudio/*.user
/Samurai-GameAudio/*.userprefs
/Samurai-GameAudio/*.pidb
/Samurai-GameAudio/*.booproj
/Samurai-GameAudio/*.svd
/Samurai-GameAudio/*.pdb
/Samurai-GameAudio/*.mdb
/Samurai-GameAudio/*.opendb
/Samurai-GameAudio/*.VC.db
/Samurai-GameAudio/*.userosscache
/Samurai-GameAudio/*.sln.docstates

# Unity generated meta files for IDE/debug files
/Samurai-GameAudio/*.pidb.meta
/Samurai-GameAudio/*.pdb.meta
/Samurai-GameAudio/*.mdb.meta

# Crash / diagnostic
/Samurai-GameAudio/sysinfo.txt
/Samurai-GameAudio/crashlytics-build.properties

# Build artifacts
/Samurai-GameAudio/*.apk
/Samurai-GameAudio/*.aab
/Samurai-GameAudio/*.unitypackage
/Samurai-GameAudio/*.app

# Packed Addressables
/Samurai-GameAudio/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/Samurai-GameAudio/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Samurai-GameAudio/[Aa]ssets/[Ss]treamingAssets/aa/*

# Optional: ignore JetBrains Rider plugin auto-generated files
/Samurai-GameAudio/[Aa]ssets/Plugins/Editor/JetBrains*

# Keep FMOD Unity plugin text normalization if needed
/Samurai-GameAudio/Assets/Plugins/FMOD/**/*.bundle text eol=lf
/Samurai-GameAudio/Assets/Plugins/FMOD/**/Info.plist text eol=lf

